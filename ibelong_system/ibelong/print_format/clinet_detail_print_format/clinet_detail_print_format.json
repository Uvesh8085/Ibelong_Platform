 "html": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Client Details</title>\r\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css\" rel=\"stylesheet\">\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\r\n    <style>\r\n        body {\r\n            background-color: #f8f9fa;\r\n            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;\r\n            padding: 20px;\r\n        }\r\n        .card {\r\n            border-radius: 10px;\r\n            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);\r\n            margin-bottom: 20px;\r\n            border: none;\r\n        }\r\n        .card-header {\r\n            background: linear-gradient(135deg, #2c3e50, #4a6580);\r\n            color: white;\r\n            border-radius: 10px 10px 0 0 !important;\r\n            padding: 15px 20px;\r\n        }\r\n        .detail-row {\r\n            border-bottom: 1px solid #eee;\r\n            padding: 12px 0;\r\n        }\r\n        .detail-row:last-child {\r\n            border-bottom: none;\r\n        }\r\n        .detail-label {\r\n            font-weight: 600;\r\n            color: #2c3e50;\r\n        }\r\n        .detail-value {\r\n            color: #555;\r\n        }\r\n        .status-badge {\r\n            padding: 5px 10px;\r\n            border-radius: 20px;\r\n            font-size: 0.85rem;\r\n            font-weight: 600;\r\n        }\r\n        .status-received {\r\n            background-color: #e3f2fd;\r\n            color: #1565c0;\r\n        }\r\n        .document-id {\r\n            background-color: #f8f9fa;\r\n            border-left: 4px solid #4a6580;\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n        }\r\n        .logo-container {\r\n            text-align: center;\r\n            padding: 15px;\r\n            background-color: white;\r\n            border-radius: 10px;\r\n            box-shadow: 0 0 10px rgba(0, 0, 0, 0.05);\r\n            margin-bottom: 20px;\r\n        }\r\n        .section-title {\r\n            border-left: 4px solid #4a6580;\r\n            padding-left: 10px;\r\n            margin: 25px 0 15px 0;\r\n            color: #2c3e50;\r\n        }\r\n        .highlight {\r\n            background-color: #fff3cd;\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            margin: 15px 0;\r\n            border-left: 4px solid #ffc107;\r\n        }\r\n        .watermark {\r\n            position: fixed;\r\n            top: 50%;\r\n            left: 50%;\r\n            transform: translate(-50%, -50%) rotate(-30deg);\r\n            font-size: 40px;\r\n            opacity: 0.05;\r\n            color: #2c3e50;\r\n            pointer-events: none;\r\n            z-index: -1;\r\n            white-space: nowrap;\r\n            font-weight: bold;\r\n        }\r\n        .jinja-code {\r\n            background-color: #2c3e50;\r\n            color: #f8f9fa;\r\n            padding: 15px;\r\n            border-radius: 5px;\r\n            font-family: monospace;\r\n            margin: 10px 0;\r\n            overflow-x: auto;\r\n        }\r\n    </style>\r\n</head>\r\n<body>\r\n    <div class=\"watermark\">CLIENT DETAILS RECORD</div>\r\n    \r\n    <div class=\"container\">\r\n        <div class=\"row mb-4\">\r\n            <div class=\"col-md-12\">\r\n                <div class=\"logo-container\">\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n                <img src=\"/files/HRD.png\" alt=\"HRD Logo\" class=\"img-fluid\" style=\"max-height: 60px; width: auto;\">\r\n            \r\n                    <h3 class=\"mt-3\">Client Details Record</h3>\r\n                    <!--<p class=\"text-muted\">Dynamic data display using Jinja templating</p>-->\r\n                <img src=\"/files/ibelong-logo.png\" alt=\"iBelong Logo\" class=\"img-fluid\" style=\"max-height: 80px; width: auto;\">\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"row\">\r\n            <div class=\"col-md-12\">\r\n                <div class=\"card\">\r\n                    <div class=\"card-header\">\r\n                        <h5 class=\"mb-0\"><i class=\"fas fa-user-circle me-2\"></i>Client Information</h5>\r\n                    </div>\r\n                    <div class=\"card-body\">\r\n                        <div class=\"document-id mb-4\">\r\n                            <div class=\"row\">\r\n                                <div class=\"col-md-6\">\r\n                                    <div class=\"detail-row\">\r\n                                        <span class=\"detail-label\">File Number:</span>\r\n                                        <span class=\"detail-value\">\r\n                                            {% if doc.file_number %}{{ doc.file_number }}{% else %}Not Provided{% endif %}\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"col-md-6\">\r\n                                    <div class=\"detail-row\">\r\n                                        <span class=\"detail-label\">Current Status:</span>\r\n                                        <span class=\"status-badge status-received\">\r\n                                            {% if doc.workflow_state %}{{ doc.workflow_state }}{% else %}Not Specified{% endif %}\r\n                                        </span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <h6 class=\"section-title\">Personal Information</h6>\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">First Name:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.first_name %}{{ doc.first_name }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Last Name:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.last_name_1 %}{{ doc.last_name_1 }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Date of Birth:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.date_of_birth %}{{ doc.date_of_birth }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Gender:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.gender %}{{ doc.gender }}{% else %}Not Specified{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Nationality:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.nationality %}{{ doc.nationality }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Country Of Birth:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.country_of_birth %}{{ doc.country_of_birth }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <h6 class=\"section-title\">Contact Information</h6>\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Mobile Number:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.mobile_number %}{{ doc.mobile_number }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Email:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.email %}{{ doc.email }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">House Number:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.house_number %}{{ doc.house_number }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <h6 class=\"section-title\">Identification Documents</h6>\r\n                        <div class=\"row\">\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">ID Card Number:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.id_card_number %}{{ doc.id_card_number }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Passport Number:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.passport_number %}{{ doc.passport_number }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n\r\n\r\n                        <h6 class=\"section-title\">Course Information</h6>\r\n<div class=\"row\">\r\n  <div class=\"col-md-12\">\r\n    <div class=\"detail-row\">\r\n      <span class=\"detail-label\">Courses assigned to the Client:</span>\r\n      <span class=\"detail-value\">\r\n        {% if doc.which_courses_are_assigned_to_the_client %}\r\n          {% for course in doc.which_courses_are_assigned_to_the_client %}\r\n            {{ course.course_name }}{% if not loop.last %}, {% endif %}\r\n          {% endfor %}\r\n        {% else %}\r\n          Not Specified\r\n        {% endif %}\r\n      </span>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n                            <div class=\"col-md-12\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Certificate for Skip Maltse Course:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.certificate %}{{ doc.certificate }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Service Provider:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.service_provider %}{{ doc.service_provider }}{% else %}Not Provided{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"col-md-6\">\r\n                                <div class=\"detail-row\">\r\n                                    <span class=\"detail-label\">Selected Course Type:</span>\r\n                                    <span class=\"detail-value\">\r\n                                        {% if doc.selected_course_type %}{{ doc.selected_course_type }}{% else %}Not Specified{% endif %}\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"highlight\">\r\n                            <div class=\"row\">\r\n                                <div class=\"col-md-12\">\r\n                                    <div class=\"detail-row\">\r\n                                        <span class=\"detail-label\">Document Status:</span>\r\n                                        <span class=\"detail-value\">This document is for reference purposes only. Please verify all information with official sources.</span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n\r\n        <div class=\"row mt-4\">\r\n            <div class=\"col-md-12 text-center\">\r\n                <p class=\"text-muted\">\u00a9 2025 Ideata Analytics. All rights reserved.</p>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <script src=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js\"></script>\r\n</body>\r\n</html>",
